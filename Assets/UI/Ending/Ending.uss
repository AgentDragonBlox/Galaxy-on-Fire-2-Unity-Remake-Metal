/* The ending (ModStation::OnRender2D at index 43): the logo and the staff credits rising over the space backdrop, Brent's
   radio lines, the fades. Positions are driven by EndingCredits. */

.ending {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ending-column {
    position: absolute;
    left: 50px;
    right: 50px;
    align-items: center;
}

.ending-logo {
    width: 452px;
    height: 156px;
    flex-shrink: 0;
}

.ending-text {
    margin-top: 80px;
    -unity-text-align: upper-center;
    white-space: normal;
    font-size: var(--text-heading);
    color: var(--gof-text);
}

.ending-fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
}
