/* Docked-station screen over the 3D hangar / Space Lounge (StationMenu). Layout like ModStation::OnRender2D:
   header with the station name, a left panel (system, tech level, race, the screen buttons), launch bottom-right.
   The root gets input-touch / input-keyboard / input-gamepad (InputMode) and can-hover while a mouse is used.
   Panel units at 1920x1080 (1600x900 on phones). */

.station-root {
    flex-grow: 1;
}

.drag-zone {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.side-shade {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 48%;
    background-image: url("project://database/Assets/UI/MainMenu/Images/shade_left.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.bottom-shade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 20%;
    background-image: url("project://database/Assets/UI/MainMenu/Images/shade_bottom.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* Rework (docs/UI-DESIGN.md "Contrast"): a scrim behind the header (the station's name, the view, credits and cargo), the
   bottom shade's gradient upside down: over the bright bars (the Terran lounge's lit ceiling) the header failed 4.5:1. */
.top-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 24%;
    background-image: url("project://database/Assets/UI/MainMenu/Images/shade_bottom.png");
    -unity-background-scale-mode: stretch-to-fill;
    scale: 1 -1;
}

.station-safe {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---- header ------------------------------------------------------------------------ */

.top-bar {
    flex-direction: row;
    align-items: center;
    padding: 32px 40px 0 48px;
}

.station-title {
    font-size: var(--text-title);
    letter-spacing: 6px;
    color: #FFFFFF;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.view-title {
    flex-grow: 1;
    margin-left: var(--space-xl);
    padding-left: var(--space-xl);
    border-left-width: 2px;
    border-left-color: var(--gof-amber);
    font-size: var(--text-subhead);
    letter-spacing: 4px;
    color: var(--gof-text-dim);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8);
}

.station-menu-button {
    display: none;
    margin-left: auto;   /* right-aligned even when the view title is hidden */
    padding: 12px 24px;
    font-size: var(--text-body);
    letter-spacing: 3px;
    color: var(--gof-text);
    background-color: var(--button-fill);
    border-width: var(--button-border);
    border-color: var(--button-line);
    border-radius: var(--button-radius);
}

.input-touch .station-menu-button,
.input-keyboard .station-menu-button {
    display: flex;
}

/* Modified: the lounge's help "?" left of Menu while the lounge shows. */
.station-lounge-help {
    display: none;
    margin-left: auto;
}

.lounge-open .station-lounge-help {
    display: flex;
}

.lounge-open .station-menu-button {
    margin-left: var(--space-l);
}

/* Modified: a window's help "?" beside its Back (the Missions window, the hangar's: OptionInfo). */
.window-help {
    align-self: center;
    margin: 0 16px 0 0;
}

.hangar-open .station-hints {
    display: none;
}

.can-hover .station-menu-button:hover {
    border-color: var(--button-focus-line);
    color: #FFFFFF;
    background-color: var(--button-focus-fill);
}

/* Remake (players' request): the credits and the hold at the top right under the bar, on the main view and in the
   Space Lounge, like the hangar window's footer (StationMenu.UpdateFunds). Not over the windows that cover that corner
   (the hangar window has its own footer, the Missions and Status windows). */
.station-funds {
    position: absolute;
    right: 40px;
    top: 112px;
    flex-direction: column;   /* the credits, the cargo under them (the user's request) */
    align-items: flex-end;
}

.station-funds-cargo,
.station-funds-credits {
    padding: 8px 16px;
    background-color: rgba(4, 10, 18, 0.6);
    border-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.station-funds-cargo {
    font-size: var(--text-body);
    letter-spacing: 1px;
    color: var(--gof-text);
}

.station-funds-cargo--over {
    color: #FF6B5E;
    border-color: #FF6B5E;
}

.station-funds-credits {
    margin-bottom: var(--space-s);
    font-size: var(--text-label);
    color: var(--gof-amber);
    border-color: var(--gof-amber);
}

.hangar-open .station-funds,
.missions-open .station-funds,
.status-open .station-funds {
    display: none;
}

/* ---- left panel -------------------------------------------------------------------- */

.side-panel {
    position: absolute;
    left: 48px;
    top: 120px;
    bottom: 64px;   /* clear of the news ticker (36 px) along the bottom edge */
    width: 440px;
}

.station-info {
    padding: 16px 16px;
    border-left-width: 3px;
    border-left-color: var(--gof-cyan);
    background-color: rgba(4, 10, 18, 0.55);
}

.info-system {
    font-size: var(--text-subhead);
    letter-spacing: 3px;
    color: #FFFFFF;
    margin-bottom: var(--space-s);
}

.info-line {
    font-size: var(--text-small);
    letter-spacing: 1px;
    color: var(--gof-text-dim);
}

/* Remake: the system's race emblem at the left of the info box (StationMenu.ShowRaceIcon). */
.station-info--emblem {
    flex-direction: row;
    align-items: center;
}

.info-lines {
    flex-grow: 1;
    flex-shrink: 1;
}

.info-race-icon {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    margin-right: var(--space-l);
    -unity-background-scale-mode: scale-to-fit;
}

.station-buttons {
    flex-grow: 1;
    justify-content: flex-end;
}

.station-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    margin: 4px 0;
    padding: 16px 20px;
    -unity-text-align: middle-left;
    font-size: var(--text-heading);
    letter-spacing: 5px;
    color: var(--gof-text-dim);
    transition-duration: 0.18s;
    transition-timing-function: ease-out-cubic;
}

.station-button--current {
    color: #FFFFFF;
    border-left-color: var(--gof-cyan);
    background-color: rgba(4, 10, 18, 0.55);
}

.can-hover .station-button:hover,
.station-button:focus {
    color: #FFFFFF;
    border-left-color: var(--gof-amber);
    background-color: var(--gof-cyan-faint);
    /* Hover moves the label, not the box: a translated box slid out from under the cursor on its edge, which then
       un-hovered and slid back (flicker, missed clicks). */
    padding-left: var(--space-xxl);
}

.station-button:active {
    color: var(--gof-amber);
}

/* ---- launch ------------------------------------------------------------------------ */

.launch-button {
    position: absolute;
    right: 40px;
    bottom: 64px;
    min-width: 260px;
    padding: 20px 32px;
    font-size: var(--text-heading);
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    color: #FFFFFF;
    background-color: var(--button-primary-fill);
    border-width: var(--button-border);
    border-color: var(--button-primary-line);
    border-radius: var(--button-radius);
    transition-duration: 0.15s;
}

.can-hover .launch-button:hover,
.launch-button:focus {
    background-color: var(--button-primary-focus-fill);
    scale: 1.04 1.04;
}

.launch-button:active {
    background-color: var(--button-press-fill);
    color: var(--button-press-text);
}

/* Its key before the text (StationMenu, InputGlyph.WithGlyphs): L with keys and mouse, X with a controller, none on touch. */
.launch-glyph--key,
.launch-glyph--pad {
    display: none;
}

.input-keyboard .launch-glyph--key,
.input-gamepad .launch-glyph--pad {
    display: flex;
}

/* ---- keyboard / controller hints (left of the launch button) ------------------------------ */

.station-hints {
    display: none;
    position: absolute;
    right: 340px;
    bottom: 64px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: flex-end;
    /* A set width, the hints right-aligned in it: sized to its hints the row came out a few pixels short of them and
       wrapped the last one (ESC BACK) onto the ticker. It still wraps the hangar window's eight. */
    width: 1000px;
}

.input-keyboard .station-hints,
.input-gamepad .station-hints {
    display: flex;
}

.station-hints .hint {
    margin-left: var(--space-s);
}

/* Modified: a hint's keys in a row of their own (StationMenu.Hint); the hangar window puts the label under them. */
.hint-keys {
    flex-direction: row;
    align-items: center;
}

/* ---- confirmation dialog (ChoiceWindow) ---------------------------------------------- */

.station-dialog-backdrop {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);   /* a modal: the station behind reads as inactive */
    justify-content: center;
    align-items: center;
}

.station-dialog-backdrop--shown {
    display: flex;
}

/* Opaque: the panel colour's 7 % shows far more than that in the linear-space UI (the lounge chat's text read through
   the confirmation and its buttons, #31). */
.station-dialog {
    width: 90%;
    max-width: 700px;
    padding: 36px 44px;
    background-color: rgb(4, 10, 18);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-amber);
}

.station-dialog-text {
    white-space: normal;
    font-size: var(--text-subhead);
    color: var(--gof-text);
    margin-bottom: 28px;
}

.station-dialog-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.station-dialog-button {
    margin-left: var(--space-m);
    font-size: var(--text-label);
}

/* Menu buttons the story hasn't unlocked yet (ModStation::OnInitialize: half transparent). */
.station-button:disabled {
    opacity: 0.35;
}

/* The story dialogue (UI/Dialogue) fills the screen. */
.dialogue-instance {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---- system menu (Menu 172: Save game, Back to Main Menu) ------------------------------ */

/* Opaque like .station-dialog: the panel colour's 93 % let the station's own buttons read through it (#31's cause). */
.system-menu {
    width: 90%;
    max-width: 820px;
    max-height: 92%;
    padding: 32px 40px;
    background-color: rgb(4, 10, 18);
    border-width: 1px;
    border-color: var(--gof-line);
    border-top-width: 3px;
    border-top-color: var(--gof-cyan);
}

.system-menu-title {
    font-size: var(--text-heading);
    letter-spacing: 6px;
    color: #FFFFFF;
    margin-bottom: 20px;
}

/* Modified: the menu's Back at the panel's top right, as the shop's (HangarWindow.uss .hangar-close). */
.system-menu-close {
    position: absolute;
    top: 26px;
    right: 40px;
    min-width: 0;
    margin: 0;
    padding: 8px 20px;
    font-size: var(--text-body);
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    color: var(--gof-text);
    background-color: rgba(4, 10, 18, 0.55);
    border-width: 2px;
    border-left-width: 2px;
    border-color: var(--gof-cyan-soft);
    border-radius: 4px;
}

.can-hover .system-menu-close:hover,
.system-menu-close:focus {
    padding-left: 20px;
    border-color: var(--gof-amber);
    color: #FFFFFF;
}

/* Modified: the Options page's title as the menu's (white): it was the shared panels' cyan. */
.options-panel > .panel-title {
    font-size: var(--text-heading);
    letter-spacing: 6px;
    color: #FFFFFF;
}

.system-menu-page {
    display: none;
    flex-shrink: 1;
}

.system-menu-page--shown {
    display: flex;
}

.system-slot-list {
    height: 480px;
}

.system-menu-back {
    margin-top: var(--space-l);
}

/* The Menu's Debug page rows (CheatsCatalog, OptionControl; the Options page is an OptionsView). */
.system-option {
    margin: 3px 0;
    padding: 8px 16px;
    font-size: var(--text-body);
    border-left-width: 3px;
    border-left-color: rgba(0, 0, 0, 0);
}

.system-option Label {
    font-size: var(--text-body);
    color: var(--gof-text);
    min-width: 230px;
}

.system-option .choice-value {
    min-width: 0;
    font-size: var(--text-small);
    color: var(--gof-cyan);
}

.system-option .binding-header > .binding-label {
    min-width: 230px;   /* the rows' name Labels have it */
}

/* The key bindings' column titles: Labels, but not option labels. */
.system-option .binding-header-cell {
    min-width: 0;
    font-size: var(--text-caption);
    color: var(--gof-text-dim);
}

.system-option .option-description {
    min-width: 0;
    font-size: var(--text-small);
    color: var(--gof-text-dim);
}

/* Phones: narrower panel. */
.layout-phone .side-panel {
    width: 380px;
}

/* Inspect ship (and its Customize screen): the menu's dark shades fade with the menu, so the view (and its screenshots) has
   no dark gradient on the left. */
.side-shade,
.bottom-shade,
.top-shade {
    transition-property: opacity;
    transition-duration: 0.45s;
}

.station-inspecting .side-shade,
.station-inspecting .bottom-shade,
.station-inspecting .top-shade {
    opacity: 0;
}

/* The star map (StarMap) is open: it draws the whole screen. */
.station-map-open .station-safe,
.station-map-open .side-shade,
.station-map-open .bottom-shade,
.station-map-open .top-shade,
.station-map-open .drag-zone {
    display: none;
}

/* ---- news ticker (NewsTicker: the main view's bottom strip, scrolling left at 50 px/s) ------------------ */
/* Remake layout: the full width of the UI along its bottom edge, always filled (StationMenu.UpdateTicker). */

.station-ticker {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 36px;
    overflow: hidden;
    background-color: rgba(4, 10, 18, 0.6);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--gof-line);
    border-bottom-color: var(--gof-line);
}

.station-ticker-text {
    position: absolute;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-left;
    white-space: nowrap;
    font-size: var(--text-body);
    color: var(--gof-text);
}

.hangar-open .station-ticker,
.lounge-open .station-ticker,
.chat-open .station-ticker,
.missions-open .station-ticker,
.status-open .station-ticker,
.station-map-open .station-ticker,
.ticker-off .station-ticker {
    display: none;
}

/* The Debug page (StationMenu.BuildStationDebug): wider, the tabs over its rows. The list is 570 px, room for Give
   items' rows, icon grid and buttons, and the page as tall as that; on a short screen it stops at 92 % and the list
   shrinks and scrolls (a fixed 480 px list overflowed short screens; filling 92 % on every screen made the page needlessly
   tall). */
.system-menu--wide {
    max-width: 1180px;   /* the Give items grid: seven icons to a row */
    height: auto;
    max-height: 92%;
    /* A window like the Options page (.options-panel, docs/UI-DESIGN.md "Shapes"): the cyan edge at the left, not the
       short menus' top band; the title's amber accent is StationMenu.debugAccent. */
    border-top-width: 1px;
    border-top-color: var(--gof-line);
    border-left-width: 3px;
    border-left-color: var(--gof-cyan);
}

.system-menu--wide .system-menu-title {
    margin-bottom: 0;
}

/* Back at the bottom left at the body size, as the Options window's; the keys' divided row under it. */
.system-menu--wide .system-menu-back {
    align-self: flex-start;
    margin-top: var(--space-s);
    font-size: var(--text-body);
}

.system-menu--wide .system-menu-page--shown {
    flex-shrink: 1;
    min-height: 0;
}

.system-menu--wide .system-slot-list {
    flex-grow: 0;
    flex-shrink: 1;
    height: 570px;
    min-height: 140px;
}

/* A small high-density screen (UiScale, the root's ui-large): bigger rows in a narrow menu (a full-width list of eight
   short entries looked stretched), the save slots wider. */
.ui-large .system-menu {
    width: 94%;
    max-width: 600px;
    max-height: 96%;
}

/* The save slots need the room: at 600 a slot's credits and playing time wrapped. */
.ui-large .system-menu--slots {
    max-width: 860px;
}

/* The Debug page as on a big screen (seven Give items icons to a row), not the whole screen: clear of the header and
   the ticker. */
.ui-large .system-menu--wide {
    max-width: 1400px;
    height: 80%;
    max-height: 80%;
}

.ui-large .system-option,
.ui-large .system-option Label {
    font-size: var(--text-heading);
}

.ui-large .system-option {
    padding: 12px 16px;
}

.ui-large .system-option .choice-value {
    font-size: var(--text-heading);
}

.system-menu--wide .system-option Label {
    min-width: 150px;
}

/* New medal (StationMenu.ShowNextMedal): a toast at the top centre that drops in and grows with a short flash, stays 5 s
   and fades out; a tap / click opens the Status window on that medal. The border, top band and title take the grade's
   colour in code. */
.medal-toast {
    position: absolute;
    top: 30px;
    left: 50%;
    translate: -50% -30px;
    scale: 0.85 0.85;
    flex-direction: row;
    align-items: center;
    min-width: 560px;
    padding: 16px 32px 16px 16px;
    background-color: rgba(6, 12, 20, 0.96);
    border-width: 2px;
    border-top-width: 5px;
    border-radius: 3px;
    opacity: 0;
    transition-property: opacity, translate, scale, background-color;
    transition-duration: 0.35s, 0.35s, 0.35s, 0.6s;
    transition-timing-function: ease-out, ease-out-back, ease-out-back, ease-out;
}

.medal-toast--shown {
    opacity: 1;
    translate: -50% 0;
    scale: 1 1;
}

/* The first moment: lit up, then settles to the dark plate. */
.medal-toast--flash {
    background-color: rgba(120, 105, 60, 0.96);
}

.medal-toast:hover {
    background-color: rgba(18, 28, 40, 0.97);
}

.medal-toast-plate {
    flex-shrink: 0;
    margin-right: var(--space-xl);
    scale: 1.1 1.1;
}

.medal-toast-title {
    font-size: var(--text-small);
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.medal-toast-name {
    font-size: var(--text-title);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.medal-toast-reward {
    font-size: var(--text-body);
    color: rgb(143, 216, 255);
    -unity-font-style: bold;
}

.medal-toast-hint {
    margin-top: var(--space-s);
    font-size: var(--text-small);
    color: rgba(216, 236, 247, 0.6);
}

/* Remake: Inspect ship (StationMenu.SetupInspect). The camera orbits the ship while the menu is away; only the ship's name,
   Back and the controls show (OrbitViewUi: .orbit-view-* in GoF2Common.uss, shared with the flight's Action Freeze). */
.inspect-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.inspect-overlay--shown {
    display: flex;
}

