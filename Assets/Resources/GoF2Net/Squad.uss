.squad {
    position: absolute;
    right: 24px;
    top: 26%;
    width: 320px;
}

/* In flight: below the Multiplayer / Distress call buttons on the right (MultiplayerWindow's column at 17 %). */
.squad--flight {
    top: 32%;
}

.squad-panel {
    margin-bottom: var(--space-s);
    background-color: rgba(0, 0, 0, 0.45);
    border-width: 1px;
    border-color: rgba(216, 236, 247, 0.2);
    border-radius: 2px;
}

.squad-header {
    margin: 0;
    padding: 8px 8px;
    font-size: var(--text-caption);
    letter-spacing: 1px;
    -unity-text-align: middle-left;
    color: rgb(143, 216, 255);
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 0;
    border-radius: 0;
}

.squad-body {
    padding: 8px 8px 8px 8px;
}

.squad-member {
    margin-bottom: var(--space-s);
}

.squad-pilot {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-s);
}

.squad-name {
    font-size: var(--text-caption);
    color: rgb(120, 230, 140);
}

.squad-pilot .squad-name {
    color: rgb(240, 214, 110);
}

.squad-where {
    font-size: var(--text-small);
    color: rgba(216, 236, 247, 0.65);
}

.squad-bar {
    height: 4px;
    margin-top: 3px;
    background-color: rgba(255, 255, 255, 0.12);
}

.squad-bar-fill {
    height: 100%;
    width: 100%;
}

.squad-bar--shield .squad-bar-fill {
    background-color: rgb(90, 170, 255);
}

.squad-bar--hull .squad-bar-fill {
    background-color: rgb(120, 230, 140);
}

.squad-bar--hull .squad-bar-armor {
    position: absolute;
    left: 0;
    top: 0;
    background-color: rgb(240, 170, 70);
}

.squad-tag {
    font-size: var(--text-caption);
    color: rgba(216, 236, 247, 0.6);
}

.squad-button {
    margin: 0;
    padding: 4px 12px;
    font-size: var(--text-caption);
    letter-spacing: 1px;
    color: var(--gof-text);
    background-color: var(--button-fill);
    border-width: var(--button-border-compact);
    border-color: var(--button-line);
    border-radius: var(--button-radius);
}

/* The flight HUD's Multiplayer and Distress call buttons: the size of the station's Menu button and the Chat button. */
.mp-hud-button {
    min-height: 50px;
    padding: 12px 24px;
    font-size: var(--text-body);
    letter-spacing: 3px;
    border-width: 2px;
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.squad-button--accept {
    color: rgb(120, 230, 140);
    border-color: rgba(120, 230, 140, 0.6);
}

.squad-button--leave {
    align-self: flex-start;
    margin-top: var(--space-xs);
    color: rgb(255, 140, 120);
    border-color: rgba(255, 140, 120, 0.5);
}

/* The invitation / trade request: the rework's panel shape (docs/UI-DESIGN.md "Shapes"), title and accent above the
   message, the answers as the shared button kinds. */
.squad-invite {
    position: absolute;
    top: 12%;
    left: 50%;
    width: 46%;
    min-width: 480px;
    max-width: 700px;
    translate: -50% 0;
    padding: 32px 36px;
    background-color: var(--gof-panel);
    border-width: 1px;
    border-color: var(--gof-line);
    border-left-width: 3px;
    border-left-color: var(--gof-cyan);
    border-radius: 2px;
}

.squad-invite-text {
    font-size: var(--text-body);
    color: var(--gof-text);
    white-space: normal;
    margin-bottom: var(--space-xl);
}

.squad-invite-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.squad-invite-buttons .gof-button {
    margin-left: var(--space-m);
}

/* the station's join code plate (an online session), under the system information */
.squad-code {
    margin-top: var(--space-s);
}

.squad-code-title {
    margin-bottom: 2px;
    font-size: var(--text-caption);
    letter-spacing: 3px;
}

.squad-code-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.squad-code-value {
    margin: 0 16px 0 0;
    letter-spacing: 5px;
}

/* Large (UiScale.Large: a small high-density screen such as a 5.5" handheld): the squad window, the invitation and the
   multiplayer window (.mpw--large) about 1.5x, the buttons finger-sized (about 6 mm on the Retroid Pocket G2). */
.squad--large.squad {
    width: 26%;
    min-width: 360px;
}

.squad--large .squad-header {
    padding: 8px 16px;
    font-size: var(--text-label);
}

.squad--large .squad-name {
    font-size: var(--text-subhead);
}

.squad--large .squad-where,
.squad--large .squad-tag {
    font-size: var(--text-body);
}

.squad--large .squad-bar {
    height: 7px;
}

.squad--large.squad-invite {
    width: 56%;
    padding: 36px 44px;
}

.squad--large .squad-invite-text {
    font-size: var(--text-subhead);
}

.squad--large .squad-button,
.mpw--large .squad-button,
.squad-button--big {
    min-height: 64px;
    min-width: 64px;
    padding: 8px 24px;
    font-size: var(--text-body);
    -unity-text-align: middle-center;
}

.squad--large .squad-invite-buttons .gof-button {
    min-width: 200px;
}

.mpw--large .unity-base-text-field__input {
    min-height: 60px;
    padding: 8px 12px;
    font-size: var(--text-subhead);
}

/* The focused control with a controller: an amber frame (the menus' look), so the D-pad's place is clear. */
.input-gamepad .squad-button:focus {
    border-color: var(--button-focus-line);
    background-color: var(--button-focus-fill);
    color: #FFFFFF;
}
